<mxfile host="app.diagrams.net"><diagram name="Search flowchart"><mxGraphModel dx="1100" dy="1360" grid="0" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="0" pageScale="1" pageWidth="1100" pageHeight="1360" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/>
<mxCell id="c2" value="&lt;b style='font-size:16px'&gt;Flowchart: what happens during one search&lt;/b&gt;&lt;br&gt;&lt;font color='#666666'&gt;per source: cache, rate limit, request, parse, then filter and sort&lt;/font&gt;" style="text;html=1;strokeColor=none;fillColor=none;whiteSpace=wrap;fontFamily=Arial;fontSize=12;fontColor=#000000;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="0" y="0" width="1060" height="44" as="geometry"/></mxCell>
<mxCell id="c3" value="&lt;b&gt;Michraz.search()&lt;/b&gt;&lt;br&gt;&lt;font color='#666666'&gt;for each source&lt;/font&gt;" style="rounded=1;arcSize=50;whiteSpace=wrap;html=1;fillColor=#cfe2f3;strokeColor=#333333;strokeWidth=2;fontFamily=Arial;fontSize=12;fontColor=#000000;" vertex="1" parent="1"><mxGeometry x="310" y="63" width="220" height="54" as="geometry"/></mxCell>
<mxCell id="c4" value="Fresh response&lt;br&gt;in the cache?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#333333;strokeWidth=2;fontFamily=Arial;fontSize=12;fontColor=#000000;" vertex="1" parent="1"><mxGeometry x="310" y="155" width="220" height="90" as="geometry"/></mxCell>
<mxCell id="c5" value="Use the cached JSON" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#efefef;strokeColor=#333333;strokeWidth=2;fontFamily=Arial;fontSize=12;fontColor=#000000;" vertex="1" parent="1"><mxGeometry x="700" y="175" width="200" height="50" as="geometry"/></mxCell>
<mxCell id="c6" value="Wait for the per-host rate limit&lt;br&gt;&lt;font color='#666666'&gt;at least 1 s apart&lt;/font&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#efefef;strokeColor=#333333;strokeWidth=2;fontFamily=Arial;fontSize=12;fontColor=#000000;" vertex="1" parent="1"><mxGeometry x="285" y="295" width="270" height="50" as="geometry"/></mxCell>
<mxCell id="c7" value="Send the request&lt;br&gt;&lt;font color='#666666'&gt;honest User-Agent&lt;/font&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#efefef;strokeColor=#333333;strokeWidth=2;fontFamily=Arial;fontSize=12;fontColor=#000000;" vertex="1" parent="1"><mxGeometry x="295" y="385" width="250" height="50" as="geometry"/></mxCell>
<mxCell id="c8" value="HTTP status?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#333333;strokeWidth=2;fontFamily=Arial;fontSize=12;fontColor=#000000;" vertex="1" parent="1"><mxGeometry x="320" y="475" width="200" height="90" as="geometry"/></mxCell>
<mxCell id="c9" value="Raise&lt;br&gt;&lt;b&gt;SourceUnavailableError&lt;/b&gt;" style="rounded=1;arcSize=50;whiteSpace=wrap;html=1;fillColor=#f4cccc;strokeColor=#333333;strokeWidth=2;fontFamily=Arial;fontSize=12;fontColor=#000000;" vertex="1" parent="1"><mxGeometry x="15" y="492" width="190" height="56" as="geometry"/></mxCell>
<mxCell id="c10" value="Back off and retry&lt;br&gt;&lt;font color='#666666'&gt;honor Retry-After, max 2 retries&lt;/font&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#fce5cd;strokeColor=#333333;strokeWidth=2;fontFamily=Arial;fontSize=12;fontColor=#000000;" vertex="1" parent="1"><mxGeometry x="675" y="492" width="250" height="56" as="geometry"/></mxCell>
<mxCell id="c11" value="Store the JSON in the cache" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#efefef;strokeColor=#333333;strokeWidth=2;fontFamily=Arial;fontSize=12;fontColor=#000000;" vertex="1" parent="1"><mxGeometry x="295" y="615" width="250" height="50" as="geometry"/></mxCell>
<mxCell id="c12" value="Parse the next record" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#d9ead3;strokeColor=#333333;strokeWidth=2;fontFamily=Arial;fontSize=12;fontColor=#000000;" vertex="1" parent="1"><mxGeometry x="295" y="715" width="250" height="50" as="geometry"/></mxCell>
<mxCell id="c13" value="Record valid?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#333333;strokeWidth=2;fontFamily=Arial;fontSize=12;fontColor=#000000;" vertex="1" parent="1"><mxGeometry x="320" y="805" width="200" height="90" as="geometry"/></mxCell>
<mxCell id="c14" value="Build a &lt;b&gt;Tender&lt;/b&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#d9ead3;strokeColor=#333333;strokeWidth=2;fontFamily=Arial;fontSize=12;fontColor=#000000;" vertex="1" parent="1"><mxGeometry x="140" y="945" width="180" height="50" as="geometry"/></mxCell>
<mxCell id="c15" value="Skip it, log a warning,&lt;br&gt;add to &lt;b&gt;last_errors&lt;/b&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#fce5cd;strokeColor=#333333;strokeWidth=2;fontFamily=Arial;fontSize=12;fontColor=#000000;" vertex="1" parent="1"><mxGeometry x="535" y="942" width="210" height="56" as="geometry"/></mxCell>
<mxCell id="c16" value="More records?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#333333;strokeWidth=2;fontFamily=Arial;fontSize=12;fontColor=#000000;" vertex="1" parent="1"><mxGeometry x="320" y="1040" width="200" height="90" as="geometry"/></mxCell>
<mxCell id="c17" value="Filter by keyword, kind and dates;&lt;br&gt;sort by deadline" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#cfe2f3;strokeColor=#333333;strokeWidth=2;fontFamily=Arial;fontSize=12;fontColor=#000000;" vertex="1" parent="1"><mxGeometry x="275" y="1172" width="290" height="56" as="geometry"/></mxCell>
<mxCell id="c18" value="Return &lt;b&gt;list[Tender]&lt;/b&gt;" style="rounded=1;arcSize=50;whiteSpace=wrap;html=1;fillColor=#cfe2f3;strokeColor=#333333;strokeWidth=2;fontFamily=Arial;fontSize=12;fontColor=#000000;" vertex="1" parent="1"><mxGeometry x="310" y="1260" width="220" height="50" as="geometry"/></mxCell>
