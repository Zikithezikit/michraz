digraph classes {
  rankdir=TB; bgcolor="white"; pad=0.35; nodesep=0.55; ranksep=0.75; splines=true;
  node [fontname="Inter", fontsize=11, shape=plain, fontcolor="#1e293b"];
  edge [fontname="Inter", fontsize=10, color="#64748b", fontcolor="#64748b", arrowsize=0.8, penwidth=1.2];

  Michraz [label=<
    <table border="1" cellborder="0" cellspacing="0" cellpadding="7" color="#93c5fd" style="rounded" bgcolor="white">
      <tr><td bgcolor="#eff6ff"><b>Michraz</b></td></tr>
      <hr/>
      <tr><td align="left" balign="left">sources: tuple[Source, ...]<br/>last_errors: list[str]</td></tr>
      <hr/>
      <tr><td align="left" balign="left">search(keyword, open_only, source, kind,<br/>       closing_before, closing_after) -&gt; list[Tender]<br/>close()</td></tr>
    </table>>];

  Source [label=<
    <table border="1" cellborder="0" cellspacing="0" cellpadding="7" color="#cbd5e1" style="rounded" bgcolor="white">
      <tr><td bgcolor="#f1f5f9"><i>&lt;&lt;protocol&gt;&gt;</i><br/><b>Source</b></td></tr>
      <hr/>
      <tr><td align="left" balign="left">name, description, attribution<br/>errors: list[str]</td></tr>
      <hr/>
      <tr><td align="left" balign="left">fetch() -&gt; Iterator[Tender]</td></tr>
    </table>>];

  BaseSource [label=<
    <table border="1" cellborder="0" cellspacing="0" cellpadding="7" color="#cbd5e1" style="rounded" bgcolor="white">
      <tr><td bgcolor="#f1f5f9"><i>&lt;&lt;abstract&gt;&gt;</i><br/><b>BaseSource[RecordT]</b></td></tr>
      <hr/>
      <tr><td align="left" balign="left">fetch() <font color="#64748b">skips, reports, dedupes</font><br/><i>records() -&gt; Iterator[RecordT]</i><br/><i>parse(record) -&gt; Tender</i></td></tr>
    </table>>];

  RmiSource [label=<
    <table border="1" cellborder="0" cellspacing="0" cellpadding="7" color="#6ee7b7" style="rounded" bgcolor="white">
      <tr><td bgcolor="#ecfdf5"><b>RmiSource</b></td></tr>
      <hr/>
      <tr><td align="left" balign="left">search(settlement_code, ...)</td></tr>
    </table>>];

  BeerShevaSource [label=<
    <table border="1" cellborder="0" cellspacing="0" cellpadding="7" color="#6ee7b7" style="rounded" bgcolor="white">
      <tr><td bgcolor="#ecfdf5"><b>BeerShevaSource</b></td></tr>
    </table>>];

  GovSource [label=<
    <table border="1" cellborder="0" cellspacing="0" cellpadding="7" color="#6ee7b7" style="rounded" bgcolor="white">
      <tr><td bgcolor="#ecfdf5"><b>GovSource</b></td></tr>
    </table>>];

  BidsSource [label=<
    <table border="1" cellborder="0" cellspacing="0" cellpadding="7" color="#6ee7b7" style="rounded" bgcolor="white">
      <tr><td bgcolor="#ecfdf5"><i>&lt;&lt;abstract&gt;&gt;</i><br/><b>BidsSource</b></td></tr>
      <hr/>
      <tr><td align="left" balign="left">publisher, domain, path</td></tr>
    </table>>];

  Cities [label=<
    <table border="1" cellborder="0" cellspacing="0" cellpadding="7" color="#6ee7b7" style="rounded" bgcolor="white">
      <tr><td bgcolor="#ecfdf5"><b>12 city classes</b></td></tr>
      <hr/>
      <tr><td align="left" balign="left">AkkoSource, AradSource,<br/>KfarSabaSource, YavneSource, ...</td></tr>
    </table>>];

  Tender [label=<
    <table border="1" cellborder="0" cellspacing="0" cellpadding="7" color="#fcd34d" style="rounded" bgcolor="white">
      <tr><td bgcolor="#fffbeb"><b>Tender</b> <font color="#64748b">(frozen)</font></td></tr>
      <hr/>
      <tr><td align="left" balign="left">source: str<br/>source_id: str<br/>title: str<br/>number: str | None<br/>deadline: datetime | None<br/>winner: str | None<br/>url: str | None<br/>kind: TenderKind<br/>documents: tuple[Document, ...]<br/>attribution: str<br/>extra: Mapping[str, Any]</td></tr>
      <hr/>
      <tr><td align="left" balign="left">key: tuple[str, str]<br/>is_open(now=None) -&gt; bool</td></tr>
    </table>>];

  Document [label=<
    <table border="1" cellborder="0" cellspacing="0" cellpadding="7" color="#fcd34d" style="rounded" bgcolor="white">
      <tr><td bgcolor="#fffbeb"><b>Document</b> <font color="#64748b">(frozen)</font></td></tr>
      <hr/>
      <tr><td align="left" balign="left">title: str<br/>url: str</td></tr>
    </table>>];

  Michraz -> Source [arrowhead=vee, headlabel="1..*", labeldistance=2.6, labelangle=35, label="  searches  "];
  BaseSource -> Source [arrowhead=empty, style=dashed];
  RmiSource -> BaseSource [arrowhead=empty];
  BeerShevaSource -> BaseSource [arrowhead=empty];
  GovSource -> BaseSource [arrowhead=empty];
  BidsSource -> BaseSource [arrowhead=empty];
  Cities -> BidsSource [arrowhead=empty];
  Source -> Tender [arrowhead=vee, style=dashed, label="  yields  "];
  Tender -> Document [dir=both, arrowtail=diamond, arrowhead=none, headlabel="0..*", taillabel="1", labeldistance=2.4, labelangle=-40];
  { rank=same; RmiSource; BeerShevaSource; GovSource; BidsSource; }
  { rank=same; Tender; Document; }
}
